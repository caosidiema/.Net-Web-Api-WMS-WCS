<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="c:\temp\nlog-internal.log">

  <!-- 日志格式模板 -->
  <variable name="logLayout"
            value="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}${newline}" />

  <targets>
    <!-- 普通日志文件（Info 及以上） -->
    <target name="log_file" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
      <target xsi:type="File"
              fileName="D:/WebApi Text/logs/app-${shortdate}.log"
              layout="${logLayout}"
              archiveAboveSize="5242880"
              maxArchiveFiles="30" />
    </target>

    <!-- 错误日志文件（Error 及以上） -->
    <target name="err_file" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
      <target xsi:type="File"
              fileName="D:/WebApi Text/logs/error-${shortdate}.log"
              layout="${logLayout}"
              archiveAboveSize="5242880"
              maxArchiveFiles="30" />
    </target>
  </targets>

  <rules>
    <!-- 过滤掉框架日志，只记录你自己代码的日志 -->
    <logger name="Microsoft.*" final="true" />
    <logger name="System.*" final="true" />

    <!-- 记录你自己的中间件和业务日志 -->
    <logger name="*" minlevel="Info" writeTo="log_file" />
    <logger name="*" minlevel="Error" writeTo="err_file" />
  </rules>
</nlog>
